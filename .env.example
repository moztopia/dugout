# Dugout machine configuration
#
# Copy this file to .env and keep values unquoted. The runner accepts only the
# documented keys below; it never evaluates this file as shell code.

DUGOUT_IMAGE_PREFIX=moztopia/dugout

DUGOUT_PHP_VERSION=8.4
DUGOUT_COMPOSER_VERSION=2
DUGOUT_NODE_VERSION=22
DUGOUT_NPM_VERSION=10

DUGOUT_PHP_NETWORK=moznet
DUGOUT_COMPOSER_NETWORK=bridge
DUGOUT_NODE_NETWORK=none
DUGOUT_NPM_NETWORK=bridge
DUGOUT_NPX_NETWORK=bridge

# Nginx Proxy Manager API credentials used by `make services-seed`. Complete
# NPM's first-run admin setup at http://localhost:81 before setting these.
DUGOUT_NPM_API_URL=http://localhost:81
DUGOUT_NPM_EMAIL=
DUGOUT_NPM_PASSWORD=

# Advanced overrides:
# DUGOUT_CACHE_HOME=/absolute/path/to/tool-cache
# DUGOUT_DOCKER=/absolute/path/to/docker
# DUGOUT_PROJECT_ROOT=/absolute/path/to/project
# DUGOUT_CATALOG=/absolute/path/to/catalog
