#!/bin/sh
set -eu

PROGRAM_NAME="dug"
DUGOUT_VERSION="1.1.0"
DUGOUT_RELEASE_NAME="Double"
NETWORK_OVERRIDE=""
SCRIPT_DIR="$(CDPATH='' cd "$(dirname "$0")" && pwd)"
DUGOUT_ROOT="$(CDPATH='' cd "${SCRIPT_DIR}/.." && pwd)"

fail() {
  printf '%s: %s\n' "${PROGRAM_NAME}" "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  dug [--network none|bridge|moznet] tool <name> [arguments...]
  dug image <name>
  dug which <name>
  dug list
  dug version
  dug verify
  dug doctor
  dug install

The command shims and machine defaults live in Dugout. A project's optional
.dugout/tool-versions file can override the machine's default image tags.
EOF
}

set_config_default() {
  config_key="$1"
  config_value="$2"

  case "${config_key}" in
    DUGOUT_IMAGE_PREFIX)
      [ -n "${DUGOUT_IMAGE_PREFIX+x}" ] ||
        DUGOUT_IMAGE_PREFIX="${config_value}"
      ;;
    DUGOUT_PHP_VERSION)
      [ -n "${DUGOUT_PHP_VERSION+x}" ] ||
        DUGOUT_PHP_VERSION="${config_value}"
      ;;
    DUGOUT_COMPOSER_VERSION)
      [ -n "${DUGOUT_COMPOSER_VERSION+x}" ] ||
        DUGOUT_COMPOSER_VERSION="${config_value}"
      ;;
    DUGOUT_NODE_VERSION)
      [ -n "${DUGOUT_NODE_VERSION+x}" ] ||
        DUGOUT_NODE_VERSION="${config_value}"
      ;;
    DUGOUT_NPM_VERSION)
      [ -n "${DUGOUT_NPM_VERSION+x}" ] ||
        DUGOUT_NPM_VERSION="${config_value}"
      ;;
    DUGOUT_DART_VERSION)
      [ -n "${DUGOUT_DART_VERSION+x}" ] ||
        DUGOUT_DART_VERSION="${config_value}"
      ;;
    DUGOUT_FLUTTER_VERSION)
      [ -n "${DUGOUT_FLUTTER_VERSION+x}" ] ||
        DUGOUT_FLUTTER_VERSION="${config_value}"
      ;;
    DUGOUT_PHP_NETWORK)
      [ -n "${DUGOUT_PHP_NETWORK+x}" ] ||
        DUGOUT_PHP_NETWORK="${config_value}"
      ;;
    DUGOUT_COMPOSER_NETWORK)
      [ -n "${DUGOUT_COMPOSER_NETWORK+x}" ] ||
        DUGOUT_COMPOSER_NETWORK="${config_value}"
      ;;
    DUGOUT_NODE_NETWORK)
      [ -n "${DUGOUT_NODE_NETWORK+x}" ] ||
        DUGOUT_NODE_NETWORK="${config_value}"
      ;;
    DUGOUT_NPM_NETWORK)
      [ -n "${DUGOUT_NPM_NETWORK+x}" ] ||
        DUGOUT_NPM_NETWORK="${config_value}"
      ;;
    DUGOUT_NPX_NETWORK)
      [ -n "${DUGOUT_NPX_NETWORK+x}" ] ||
        DUGOUT_NPX_NETWORK="${config_value}"
      ;;
    DUGOUT_DART_NETWORK)
      [ -n "${DUGOUT_DART_NETWORK+x}" ] ||
        DUGOUT_DART_NETWORK="${config_value}"
      ;;
    DUGOUT_FLUTTER_NETWORK)
      [ -n "${DUGOUT_FLUTTER_NETWORK+x}" ] ||
        DUGOUT_FLUTTER_NETWORK="${config_value}"
      ;;
    DUGOUT_FLUTTER_EDITOR_SDK)
      [ -n "${DUGOUT_FLUTTER_EDITOR_SDK+x}" ] ||
        DUGOUT_FLUTTER_EDITOR_SDK="${config_value}"
      ;;
    DUGOUT_MINIO_ROOT_USER)
      [ -n "${DUGOUT_MINIO_ROOT_USER+x}" ] ||
        DUGOUT_MINIO_ROOT_USER="${config_value}"
      ;;
    DUGOUT_MINIO_ROOT_PASSWORD)
      [ -n "${DUGOUT_MINIO_ROOT_PASSWORD+x}" ] ||
        DUGOUT_MINIO_ROOT_PASSWORD="${config_value}"
      ;;
    DUGOUT_NPM_API_URL | DUGOUT_NPM_EMAIL | DUGOUT_NPM_PASSWORD)
      # Service-seeding configuration is accepted but unused by the tool runner.
      ;;
    DUGOUT_CACHE_HOME)
      [ -n "${DUGOUT_CACHE_HOME+x}" ] ||
        DUGOUT_CACHE_HOME="${config_value}"
      ;;
    DUGOUT_DOCKER)
      [ -n "${DUGOUT_DOCKER+x}" ] ||
        DUGOUT_DOCKER="${config_value}"
      ;;
    DUGOUT_PROJECT_ROOT)
      [ -n "${DUGOUT_PROJECT_ROOT+x}" ] ||
        DUGOUT_PROJECT_ROOT="${config_value}"
      ;;
    DUGOUT_CATALOG)
      [ -n "${DUGOUT_CATALOG+x}" ] ||
        DUGOUT_CATALOG="${config_value}"
      ;;
    *)
      fail "unsupported key in ${CONFIG_FILE}: ${config_key}"
      ;;
  esac
}

load_config() {
  if [ -n "${DUGOUT_CONFIG:-}" ]; then
    CONFIG_FILE="${DUGOUT_CONFIG}"
  elif [ -f "${DUGOUT_ROOT}/.env" ]; then
    CONFIG_FILE="${DUGOUT_ROOT}/.env"
  else
    CONFIG_FILE="${XDG_CONFIG_HOME:-${HOME}/.config}/dugout/.env"
  fi

  [ -e "${CONFIG_FILE}" ] || return 0
  [ -r "${CONFIG_FILE}" ] ||
    fail "configuration file is not readable: ${CONFIG_FILE}"

  while IFS= read -r config_line || [ -n "${config_line}" ]; do
    case "${config_line}" in
      "" | \#*) continue ;;
      *=*)
        config_key="${config_line%%=*}"
        config_value="${config_line#*=}"
        ;;
      *)
        fail "expected KEY=value in ${CONFIG_FILE}: ${config_line}"
        ;;
    esac

    case "${config_key}" in
      *[!A-Z0-9_]* | "")
        fail "invalid key in ${CONFIG_FILE}: ${config_key}"
        ;;
    esac

    case "${config_value}" in
      *'
'*)
        fail "multiline values are not supported in ${CONFIG_FILE}"
        ;;
    esac

    set_config_default "${config_key}" "${config_value}"
  done < "${CONFIG_FILE}"
}

validate_version() {
  version_name="$1"
  version_value="$2"

  case "${version_value}" in
    "" | *[!A-Za-z0-9._-]*)
      fail "invalid ${version_name}: ${version_value}"
      ;;
  esac
}

validate_network() {
  network_name="$1"
  network_value="$2"

  case "${network_value}" in
    none | bridge | moznet) ;;
    *) fail "invalid ${network_name}: ${network_value}" ;;
  esac
}

apply_config_defaults() {
  DUGOUT_IMAGE_PREFIX="${DUGOUT_IMAGE_PREFIX:-moztopia/dugout}"
  DUGOUT_PHP_VERSION="${DUGOUT_PHP_VERSION:-8.4}"
  DUGOUT_COMPOSER_VERSION="${DUGOUT_COMPOSER_VERSION:-2}"
  DUGOUT_NODE_VERSION="${DUGOUT_NODE_VERSION:-22}"
  DUGOUT_NPM_VERSION="${DUGOUT_NPM_VERSION:-10}"
  DUGOUT_DART_VERSION="${DUGOUT_DART_VERSION:-3.12.2}"
  DUGOUT_FLUTTER_VERSION="${DUGOUT_FLUTTER_VERSION:-3.44.2}"
  DUGOUT_PHP_NETWORK="${DUGOUT_PHP_NETWORK:-moznet}"
  DUGOUT_COMPOSER_NETWORK="${DUGOUT_COMPOSER_NETWORK:-bridge}"
  DUGOUT_NODE_NETWORK="${DUGOUT_NODE_NETWORK:-none}"
  DUGOUT_NPM_NETWORK="${DUGOUT_NPM_NETWORK:-bridge}"
  DUGOUT_NPX_NETWORK="${DUGOUT_NPX_NETWORK:-bridge}"
  DUGOUT_DART_NETWORK="${DUGOUT_DART_NETWORK:-bridge}"
  DUGOUT_FLUTTER_NETWORK="${DUGOUT_FLUTTER_NETWORK:-bridge}"
  DUGOUT_DOCKER="${DUGOUT_DOCKER:-docker}"

  case "${DUGOUT_IMAGE_PREFIX}" in
    "" | *[!A-Za-z0-9./:_-]*)
      fail "invalid DUGOUT_IMAGE_PREFIX: ${DUGOUT_IMAGE_PREFIX}"
      ;;
  esac

  validate_version "DUGOUT_PHP_VERSION" "${DUGOUT_PHP_VERSION}"
  validate_version "DUGOUT_COMPOSER_VERSION" "${DUGOUT_COMPOSER_VERSION}"
  validate_version "DUGOUT_NODE_VERSION" "${DUGOUT_NODE_VERSION}"
  validate_version "DUGOUT_NPM_VERSION" "${DUGOUT_NPM_VERSION}"
  validate_version "DUGOUT_DART_VERSION" "${DUGOUT_DART_VERSION}"
  validate_version "DUGOUT_FLUTTER_VERSION" "${DUGOUT_FLUTTER_VERSION}"
  validate_network "DUGOUT_PHP_NETWORK" "${DUGOUT_PHP_NETWORK}"
  validate_network "DUGOUT_COMPOSER_NETWORK" "${DUGOUT_COMPOSER_NETWORK}"
  validate_network "DUGOUT_NODE_NETWORK" "${DUGOUT_NODE_NETWORK}"
  validate_network "DUGOUT_NPM_NETWORK" "${DUGOUT_NPM_NETWORK}"
  validate_network "DUGOUT_NPX_NETWORK" "${DUGOUT_NPX_NETWORK}"
  validate_network "DUGOUT_DART_NETWORK" "${DUGOUT_DART_NETWORK}"
  validate_network "DUGOUT_FLUTTER_NETWORK" "${DUGOUT_FLUTTER_NETWORK}"

  case "${DUGOUT_DOCKER}" in
    "" | *'
'*) fail "invalid DUGOUT_DOCKER" ;;
  esac

  if [ -n "${DUGOUT_FLUTTER_EDITOR_SDK:-}" ]; then
    case "${DUGOUT_FLUTTER_EDITOR_SDK}" in
      /*) ;;
      *) fail "DUGOUT_FLUTTER_EDITOR_SDK must be an absolute path" ;;
    esac
    [ -d "${DUGOUT_FLUTTER_EDITOR_SDK}/packages/flutter" ] ||
      fail "invalid DUGOUT_FLUTTER_EDITOR_SDK: ${DUGOUT_FLUTTER_EDITOR_SDK}"
  fi

  IMAGE_PREFIX="${DUGOUT_IMAGE_PREFIX}"
  DOCKER_COMMAND="${DUGOUT_DOCKER}"
}

resolve_catalog() {
  if [ -n "${DUGOUT_CATALOG:-}" ]; then
    CATALOG="${DUGOUT_CATALOG}"
  else
    CATALOG="${DUGOUT_ROOT}/share/dugout/catalog"
  fi

  [ -r "${CATALOG}" ] ||
    fail "tool catalog not found: ${CATALOG}"
}

find_manifest_root() {
  candidate="$(pwd -P)"

  while :; do
    if [ -f "${candidate}/.dugout/tool-versions" ]; then
      PROJECT_ROOT="${candidate}"
      MANIFEST="${candidate}/.dugout/tool-versions"
      return 0
    fi

    [ "${candidate}" != "/" ] || return 1
    candidate="$(dirname "${candidate}")"
  done
}

resolve_project_root() {
  MANIFEST=""

  if [ -n "${DUGOUT_PROJECT_ROOT:-}" ]; then
    [ -d "${DUGOUT_PROJECT_ROOT}" ] ||
      fail "DUGOUT_PROJECT_ROOT is not a directory: ${DUGOUT_PROJECT_ROOT}"
    PROJECT_ROOT="$(CDPATH='' cd "${DUGOUT_PROJECT_ROOT}" && pwd -P)"
  elif find_manifest_root; then
    :
  elif command -v git >/dev/null 2>&1 &&
    git_root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    PROJECT_ROOT="$(CDPATH='' cd "${git_root}" && pwd -P)"
  else
    PROJECT_ROOT="$(pwd -P)"
  fi

  current_directory="$(pwd -P)"
  case "${current_directory}" in
    "${PROJECT_ROOT}" | "${PROJECT_ROOT}"/*) ;;
    *)
      fail "current directory is outside project root: ${PROJECT_ROOT}"
      ;;
  esac

  case "${PROJECT_ROOT}" in
    *,*)
      fail "workspace paths containing commas are not supported: ${PROJECT_ROOT}"
      ;;
  esac
}

validate_tool_name() {
  case "$1" in
    "" | *[!a-z0-9-]* | -* | *-)
      fail "invalid tool name: $1"
      ;;
  esac
}

load_policy() {
  tool_name="$1"
  validate_tool_name "${tool_name}"

  catalog_entry="$(
    awk -F '|' -v tool="${tool_name}" '
      $1 == tool {
        found++
        entry = $0
      }
      END {
        if (found != 1) {
          exit 1
        }
        print entry
      }
    ' "${CATALOG}"
  )" || fail "tool is not present exactly once in the Dugout catalog: ${tool_name}"

  original_ifs="${IFS}"
  IFS='|'
  read -r POLICY_TOOL POLICY_NETWORK POLICY_WORKSPACE POLICY_CACHE <<EOF
${catalog_entry}
EOF
  IFS="${original_ifs}"

  [ "${POLICY_TOOL}" = "${tool_name}" ] ||
    fail "catalog returned the wrong tool for: ${tool_name}"

  case "${POLICY_WORKSPACE}" in
    readonly | writable) ;;
    *) fail "invalid workspace policy for ${tool_name}: ${POLICY_WORKSPACE}" ;;
  esac

  case "${tool_name}" in
    php) POLICY_NETWORK="${DUGOUT_PHP_NETWORK}" ;;
    composer) POLICY_NETWORK="${DUGOUT_COMPOSER_NETWORK}" ;;
    node) POLICY_NETWORK="${DUGOUT_NODE_NETWORK}" ;;
    npm) POLICY_NETWORK="${DUGOUT_NPM_NETWORK}" ;;
    npx) POLICY_NETWORK="${DUGOUT_NPX_NETWORK}" ;;
    dart) POLICY_NETWORK="${DUGOUT_DART_NETWORK}" ;;
    flutter) POLICY_NETWORK="${DUGOUT_FLUTTER_NETWORK}" ;;
  esac
}

default_tool_version() {
  tool_name="$1"

  case "${tool_name}" in
    php)
      printf '%s\n' "${DUGOUT_PHP_VERSION}"
      ;;
    composer)
      php_tag="$(printf '%s' "${DUGOUT_PHP_VERSION}" | tr -d '.')"
      printf '%s-php%s\n' "${DUGOUT_COMPOSER_VERSION}" "${php_tag}"
      ;;
    node)
      printf '%s\n' "${DUGOUT_NODE_VERSION}"
      ;;
    npm | npx)
      printf '%s-node%s\n' "${DUGOUT_NPM_VERSION}" "${DUGOUT_NODE_VERSION}"
      ;;
    dart)
      printf '%s\n' "${DUGOUT_DART_VERSION}"
      ;;
    flutter)
      printf '%s\n' "${DUGOUT_FLUTTER_VERSION}"
      ;;
    *)
      fail "no machine default version is configured for: ${tool_name}"
      ;;
  esac
}

tool_version() {
  tool_name="$1"

  if [ -n "${MANIFEST}" ]; then
    awk -v tool="${tool_name}" '
      /^[[:space:]]*($|#)/ {
        next
      }
      NF != 2 {
        invalid = 1
        next
      }
      $1 == tool {
        found++
        version = $2
      }
      END {
        if (invalid || found != 1) {
          exit 1
        }
        print version
      }
    ' "${MANIFEST}" ||
      fail "tool must appear exactly once in ${MANIFEST}: ${tool_name}"
  else
    default_tool_version "${tool_name}"
  fi
}

resolve_image() {
  tool_name="$1"
  version="$(tool_version "${tool_name}")"
  validate_version "image tag for ${tool_name}" "${version}"
  IMAGE="${IMAGE_PREFIX}-${tool_name}:${version}"
}

container_workdir() {
  current_directory="$(pwd -P)"

  case "${current_directory}" in
    "${PROJECT_ROOT}")
      printf '%s\n' "/workspace"
      ;;
    "${PROJECT_ROOT}"/*)
      relative_directory="${current_directory#"${PROJECT_ROOT}"/}"
      printf '/workspace/%s\n' "${relative_directory}"
      ;;
    *)
      fail "current directory is outside project root: ${PROJECT_ROOT}"
      ;;
  esac
}

selected_network() {
  if [ -n "${NETWORK_OVERRIDE}" ]; then
    network="${NETWORK_OVERRIDE}"
  else
    network="${POLICY_NETWORK}"
  fi

  case "${network}" in
    none | bridge)
      printf '%s\n' "${network}"
      ;;
    moznet)
      "${DOCKER_COMMAND}" network inspect moznet \
        >/dev/null 2>&1 ||
        fail "tool ${POLICY_TOOL} requires moznet; start or repair Dugout first"
      printf '%s\n' "moznet"
      ;;
    *)
      fail "unsupported network: ${network}"
      ;;
  esac
}

cache_directory() {
  [ -n "${POLICY_CACHE}" ] || return 1

  cache_base="${DUGOUT_CACHE_HOME:-${XDG_CACHE_HOME:-${HOME}/.cache}/dugout}"
  safe_version="$(printf '%s' "${version}" | tr '/:@' '____')"
  CACHE_DIRECTORY="${cache_base}/${POLICY_CACHE}-${safe_version}"
  mkdir -p "${CACHE_DIRECTORY}"
}

detect_flutter_editor_sdk() {
  FLUTTER_EDITOR_SDK="${DUGOUT_FLUTTER_EDITOR_SDK:-}"
  [ -z "${FLUTTER_EDITOR_SDK}" ] || return 0

  path_ifs="${IFS}"
  IFS=':'
  for path_directory in ${PATH:-}; do
    [ -n "${path_directory}" ] || path_directory="."
    candidate="${path_directory}/flutter"
    [ -x "${candidate}" ] || continue
    candidate_root="$(
      CDPATH='' cd "${path_directory}/.." 2>/dev/null && pwd -P
    )" || continue
    if [ -d "${candidate_root}/packages/flutter" ]; then
      FLUTTER_EDITOR_SDK="${candidate_root}"
      break
    fi
  done
  IFS="${path_ifs}"
}

restore_flutter_editor_metadata() {
  [ -n "${FLUTTER_EDITOR_SDK:-}" ] || return 0

  package_config="$(pwd -P)/.dart_tool/package_config.json"
  [ -f "${package_config}" ] || return 0

  case "${FLUTTER_EDITOR_SDK}" in
    *[\#\&\\]* | *'
'*)
      fail "unsupported character in Flutter editor SDK path"
      ;;
  esac

  package_config_tmp="${package_config}.dugout.$$"
  sed \
    "s#file:///opt/flutter#file://${FLUTTER_EDITOR_SDK}#g" \
    "${package_config}" > "${package_config_tmp}"
  mv "${package_config_tmp}" "${package_config}"
}

run_tool() {
  tool_name="$1"
  shift

  resolve_project_root
  load_policy "${tool_name}"
  resolve_image "${tool_name}"
  workdir="$(container_workdir)"
  network="$(selected_network)"
  user_id="$(id -u)"
  group_id="$(id -g)"

  if [ "${POLICY_WORKSPACE}" = "readonly" ]; then
    workspace_mount="type=bind,src=${PROJECT_ROOT},dst=/workspace,readonly"
  else
    workspace_mount="type=bind,src=${PROJECT_ROOT},dst=/workspace"
  fi

  set -- "${IMAGE}" "$@"

  if cache_directory; then
    case "${CACHE_DIRECTORY}" in
      *,*)
        fail "cache paths containing commas are not supported: ${CACHE_DIRECTORY}"
        ;;
    esac

    case "${tool_name}" in
      composer)
        set -- \
          --mount "type=bind,src=${CACHE_DIRECTORY},dst=/cache" \
          "$@"
        set -- --env "COMPOSER_CACHE_DIR=/cache" "$@"
        ;;
      npm | npx)
        set -- \
          --mount "type=bind,src=${CACHE_DIRECTORY},dst=/cache" \
          "$@"
        set -- --env "npm_config_cache=/cache" "$@"
        ;;
      dart)
        set -- \
          --mount "type=bind,src=${CACHE_DIRECTORY},dst=${CACHE_DIRECTORY}" \
          "$@"
        set -- --env "PUB_CACHE=${CACHE_DIRECTORY}/pub" "$@"
        ;;
      flutter)
        detect_flutter_editor_sdk
        set -- \
          --mount "type=bind,src=${CACHE_DIRECTORY},dst=${CACHE_DIRECTORY}" \
          "$@"
        set -- \
          --env "PUB_CACHE=${CACHE_DIRECTORY}/pub" \
          --env "GRADLE_USER_HOME=${CACHE_DIRECTORY}/gradle" \
          "$@"
        ;;
    esac
  fi

  if [ -t 0 ] && [ -t 1 ]; then
    set -- --tty "$@"
  fi

  # Flutter maintains SDK-local metadata even for ordinary project commands.
  # Its container is still ephemeral, unprivileged, capability-free, and
  # removed at exit, but it cannot use Docker's read-only-rootfs option.
  if [ "${tool_name}" != "flutter" ]; then
    set -- --read-only "$@"
  fi

  set -- \
    "${DOCKER_COMMAND}" run \
    --rm \
    --init \
    --interactive \
    --label "dev.moztopia.dugout.tool=${tool_name}" \
    --user "${user_id}:${group_id}" \
    --workdir "${workdir}" \
    --mount "${workspace_mount}" \
    --tmpfs "/tmp:rw,nosuid,nodev,exec" \
    --env "HOME=/tmp/dugout-home" \
    --security-opt "no-new-privileges=true" \
    --cap-drop "ALL" \
    --network "${network}" \
    "$@"
  tool_status=0
  "$@" || tool_status=$?

  if [ "${tool_name}" = "flutter" ]; then
    restore_flutter_editor_metadata
  fi

  exit "${tool_status}"
}

configured_tools() {
  if [ -n "${MANIFEST}" ]; then
    awk '
      /^[[:space:]]*($|#)/ {
        next
      }
      NF != 2 {
        exit 1
      }
      seen[$1]++ {
        exit 1
      }
      {
        print $1 "|" $2
      }
    ' "${MANIFEST}" ||
      fail "invalid or duplicate entry in ${MANIFEST}"
  else
    awk -F '|' '
      !/^[[:space:]]*($|#)/ {
        print $1
      }
    ' "${CATALOG}" |
      while IFS= read -r configured_tool; do
        printf '%s|%s\n' \
          "${configured_tool}" \
          "$(default_tool_version "${configured_tool}")"
      done
  fi
}

verify_project() {
  resolve_project_root
  entries="$(configured_tools)"
  [ -n "${entries}" ] || fail "no Dugout tools are configured"

  newline='
'
  original_ifs="${IFS}"
  IFS="${newline}"
  for entry in ${entries}; do
    tool_name="${entry%%|*}"
    version="${entry#*|}"
    load_policy "${tool_name}"
    validate_version "image tag for ${tool_name}" "${version}"

    [ -x "${SCRIPT_DIR}/${tool_name}" ] ||
      fail "missing executable Dugout shim: ${SCRIPT_DIR}/${tool_name}"

    image="${IMAGE_PREFIX}-${tool_name}:${version}"
    "${DOCKER_COMMAND}" image inspect "${image}" >/dev/null 2>&1 ||
      fail "required image is not available locally: ${image}"
  done
  IFS="${original_ifs}"

  printf '%s\n' "Dugout configuration is valid for ${PROJECT_ROOT}."
}

doctor() {
  command -v "${DOCKER_COMMAND}" >/dev/null 2>&1 ||
    fail "Docker CLI is unavailable: ${DOCKER_COMMAND}"
  "${DOCKER_COMMAND}" info >/dev/null 2>&1 ||
    fail "cannot reach the Docker daemon"

  printf '%s\n' "Docker daemon is available."

  if "${DOCKER_COMMAND}" network inspect moznet \
    >/dev/null 2>&1; then
    printf '%s\n' "moznet is available."
  else
    printf '%s\n' \
      "moznet is unavailable; moznet tools will not run." >&2
  fi

  verify_project
}

install_runner() {
  source_runner="${SCRIPT_DIR}/$(basename "$0")"
  install_prefix="${DUGOUT_INSTALL_PREFIX:-${HOME}/.local}"
  target_bin="${install_prefix}/bin"
  target_share="${install_prefix}/share/dugout"
  target_config="${XDG_CONFIG_HOME:-${HOME}/.config}/dugout"

  mkdir -p "${target_bin}" "${target_share}" "${target_config}"
  cp "${source_runner}" "${target_bin}/dug"
  cp "${CATALOG}" "${target_share}/catalog"

  for tool_name in php composer node npm npx dart flutter; do
    cp "${SCRIPT_DIR}/${tool_name}" "${target_bin}/${tool_name}"
    chmod 0755 "${target_bin}/${tool_name}"
  done

  if [ -r "${DUGOUT_ROOT}/.env.example" ]; then
    cp "${DUGOUT_ROOT}/.env.example" "${target_config}/.env.example"
    if [ ! -e "${target_config}/.env" ]; then
      if [ -r "${DUGOUT_ROOT}/.env" ]; then
        cp "${DUGOUT_ROOT}/.env" "${target_config}/.env"
      else
        cp "${DUGOUT_ROOT}/.env.example" "${target_config}/.env"
      fi
    fi
  fi

  chmod 0755 "${target_bin}/dug"
  chmod 0644 "${target_share}/catalog"

  printf 'Installed runner and shims under: %s\n' "${target_bin}"
  printf 'Installed catalog: %s\n' "${target_share}/catalog"
  printf 'Installed configuration: %s\n' "${target_config}"
}

load_config
apply_config_defaults
resolve_catalog

while [ "$#" -gt 0 ]; do
  case "$1" in
    --network)
      [ "$#" -ge 2 ] || fail "--network requires a value"
      NETWORK_OVERRIDE="$2"
      validate_network "--network" "${NETWORK_OVERRIDE}"
      shift 2
      ;;
    --help | -h)
      usage
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

[ "$#" -gt 0 ] || {
  usage
  exit 1
}

command_name="$1"
shift

case "${command_name}" in
  tool)
    [ "$#" -gt 0 ] || fail "tool requires a tool name"
    run_tool "$@"
    ;;
  image)
    [ "$#" -eq 1 ] || fail "image requires exactly one tool name"
    resolve_project_root
    load_policy "$1"
    resolve_image "$1"
    printf '%s\n' "${IMAGE}"
    ;;
  which)
    [ "$#" -eq 1 ] || fail "which requires exactly one tool name"
    resolve_project_root
    load_policy "$1"
    resolve_image "$1"
    printf 'shim: %s\n' "${SCRIPT_DIR}/$1"
    printf 'image: %s\n' "${IMAGE}"
    ;;
  list)
    [ "$#" -eq 0 ] || fail "list takes no arguments"
    resolve_project_root
    configured_tools | tr '|' ' '
    ;;
  version)
    [ "$#" -eq 0 ] || fail "version takes no arguments"
    printf 'dug %s (%s)\n' "${DUGOUT_VERSION}" "${DUGOUT_RELEASE_NAME}"
    ;;
  verify)
    [ "$#" -eq 0 ] || fail "verify takes no arguments"
    verify_project
    ;;
  doctor)
    [ "$#" -eq 0 ] || fail "doctor takes no arguments"
    doctor
    ;;
  install)
    [ "$#" -eq 0 ] || fail "install takes no arguments"
    install_runner
    ;;
  *)
    fail "unknown command: ${command_name}"
    ;;
esac
