#!/bin/sh
# Dugout — containerized development tools
set -eu

PREFIX="ghcr.io/moztopia/dugout"
DUGOUT_ROOT="$(cd "$(dirname "$0")" && pwd)"
INSTALL_DIR="${HOME}/.local/bin/dugout"
REPO="https://github.com/moztopia/dugout/raw/main"
SHIMS="node npm npx php composer mysql mariadb redis-cli ffmpeg ffprobe psql sqlite3 gcc g++ make cmake nasm fasm gdb go rustc cargo"

# ── Image definitions ────────────────────────────────────────
# name|dockerfile|build_arg|versions (space-separated)
IMAGES="
node    | .docker/images/node.Dockerfile    | NODE_VERSION     | 22 24 26
php     | .docker/images/php.Dockerfile     | PHP_VERSION      | 8.2 8.3 8.4 8.5
mysql   | .docker/images/mysql.Dockerfile   | MYSQL_VERSION    | 8.4
mariadb | .docker/images/mariadb.Dockerfile | MARIADB_VERSION  | 10.11 11.4
redis   | .docker/images/redis.Dockerfile   | REDIS_VERSION    | 7.2 7.4
ffmpeg  | .docker/images/ffmpeg.Dockerfile  | FFMPEG_VERSION   | latest
psql    | .docker/images/psql.Dockerfile    | POSTGRES_VERSION | 16 17
sqlite  | .docker/images/sqlite.Dockerfile  | SQLITE_VERSION   | latest
cdev    | .docker/images/cdev.Dockerfile    | CDEV_VERSION     | latest
go      | .docker/images/go.Dockerfile      | GO_VERSION       | 1.25 1.26
rust    | .docker/images/rust.Dockerfile    | RUST_VERSION     | stable
"

# ── Helpers ──────────────────────────────────────────────────

usage() {
  cat <<'EOF'
Usage:
  dugout <command>

Commands:
  dugout status                   Show installed shims and Docker status
  dugout uninstall                Remove all shims from ~/.local/bin/dugout
  dugout shims <action> [tool]    Manage containerized tool images

Shims actions:
  dugout shims build   [tool]     Build images (all or specific tool)
  dugout shims push    [tool]     Push images to GHCR (all or specific tool)
  dugout shims install            Download and install shims from GitHub
  dugout shims deploy  [tool]     Build + install + push (all or specific tool)
  dugout shims images             List all defined images and versions
EOF
}

parse_image() {
  _name="$(echo "$1" | cut -d'|' -f1 | tr -d ' ')"
  _file="$(echo "$1" | cut -d'|' -f2 | tr -d ' ')"
  _arg="$(echo "$1" | cut -d'|' -f3 | tr -d ' ')"
  _versions="$(echo "$1" | cut -d'|' -f4 | sed 's/^ *//')"
}

each_image() {
  action="$1"
  filter="${2:-}"

  echo "$IMAGES" | while IFS= read -r line; do
    line="$(echo "$line" | sed 's/^[[:space:]]*//')"
    [ -n "$line" ] || continue

    parse_image "$line"

    if [ -n "$filter" ] && [ "$_name" != "$filter" ]; then
      continue
    fi

    for ver in $_versions; do
      "$action" "$_name" "$_file" "$_arg" "$ver"
    done
  done

  if [ -n "$filter" ]; then
    echo "$IMAGES" | while IFS= read -r line; do
      line="$(echo "$line" | sed 's/^[[:space:]]*//')"
      [ -n "$line" ] || continue
      parse_image "$line"
      [ "$_name" = "$filter" ] && echo "found"
    done | grep -q "found" || {
      printf 'Unknown tool: %s\n' "$filter" >&2
      exit 1
    }
  fi
}

# ── Actions ──────────────────────────────────────────────────

require_maintainer() {
  printf '\n  Maintainer operation — requires the dugout repo and ghcr.io write access.\n'
  printf '  Continue? [y/N] '
  read -r confirm
  case "$confirm" in
    y|Y|yes|YES) ;;
    *) printf '  Aborted.\n\n'; exit 0 ;;
  esac
}

do_build() {
  name="$1" file="$2" arg="$3" ver="$4"
  tag="${PREFIX}-${name}:${ver}"
  printf '  Building %s\n' "$tag"
  docker build \
    --build-arg "${arg}=${ver}" \
    --file "${DUGOUT_ROOT}/${file}" \
    --tag "$tag" \
    "$DUGOUT_ROOT"
}

do_push() {
  name="$1" file="$2" arg="$3" ver="$4"
  tag="${PREFIX}-${name}:${ver}"
  printf '  Pushing %s\n' "$tag"
  docker push "$tag"
}

do_install() {
  mkdir -p "$INSTALL_DIR"
  for shim in $SHIMS; do
    curl -fsSL "$REPO/bin/$shim" -o "$INSTALL_DIR/$shim"
    chmod +x "$INSTALL_DIR/$shim"
    printf '  ✓ %s\n' "$shim"
  done
}

do_list() {
  name="$1" file="$2" arg="$3" ver="$4"
  printf '  %-12s %s\n' "$name" "${PREFIX}-${name}:${ver}"
}

# ── Main ─────────────────────────────────────────────────────

# Help anywhere in the args → show usage
for arg in "$@"; do
  case "$arg" in help|-h|--help) usage; exit 0 ;; esac
done

[ "$#" -gt 0 ] || { usage; exit 1; }

command="$1"
shift

case "$command" in
  shims)
    [ "$#" -gt 0 ] || { usage; exit 1; }
    subcommand="$1"
    shift
    tool="${1:-}"

    case "$subcommand" in
      build)
        require_maintainer
        printf '\nBuilding images:\n'
        each_image do_build "$tool"
        printf '\nDone.\n\n'
        ;;
      push)
        require_maintainer
        printf '\nPushing images:\n'
        each_image do_push "$tool"
        printf '\nDone.\n\n'
        ;;
      install)
        printf '\nInstalling shims:\n'
        do_install
        printf '\nDone.\n\n'
        ;;
      deploy)
        require_maintainer
        printf '\nBuilding images:\n'
        each_image do_build "$tool"
        printf '\nInstalling shims:\n'
        do_install
        printf '\nPushing images:\n'
        each_image do_push "$tool"
        printf '\nDone.\n\n'
        ;;
      images)
        printf '\nDefined images:\n'
        each_image do_list ""
        printf '\n'
        ;;
      *)
        usage
        exit 1
        ;;
    esac
    ;;
  status)
    printf '\n  Dugout Status\n\n'

    # Docker check
    if command -v docker >/dev/null 2>&1; then
      docker_ver="$(docker --version 2>/dev/null | head -1)"
      printf '  Docker:    ✓ %s\n' "$docker_ver"
    else
      printf '  Docker:    ✗ not found\n'
    fi

    # PATH check
    case ":${PATH}:" in
      *":${INSTALL_DIR}:"*) printf '  PATH:      ✓ %s\n' "$INSTALL_DIR" ;;
      *) printf '  PATH:      ✗ %s not in PATH\n' "$INSTALL_DIR" ;;
    esac

    # Installed shims
    printf '\n  Installed shims:\n'
    if [ -d "$INSTALL_DIR" ]; then
      for shim in "$INSTALL_DIR"/*; do
        [ -f "$shim" ] || continue
        name="$(basename "$shim")"
        [ "$name" = "dugout" ] && continue
        printf '    ✓ %s\n' "$name"
      done
    else
      printf '    (none)\n'
    fi
    printf '\n'
    ;;
  uninstall)
    printf '\n  This will remove all dugout shims and the dugout CLI from:\n'
    printf '    %s\n\n' "$INSTALL_DIR"
    printf '  Continue? [y/N] '
    read -r confirm
    case "$confirm" in
      y|Y|yes|YES) ;;
      *) printf '  Aborted.\n\n'; exit 0 ;;
    esac
    if [ -d "$INSTALL_DIR" ]; then
      rm -rf "$INSTALL_DIR"
      printf '\n  ✓ Removed %s\n' "$INSTALL_DIR"
    else
      printf '\n  (nothing to remove)\n'
    fi
    printf '\n  Optionally remove cached images:\n'
    printf '    docker images "ghcr.io/moztopia/dugout-*" -q | xargs docker rmi\n\n'
    ;;
  *)
    usage
    exit 1
    ;;
esac
