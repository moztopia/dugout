#!/bin/sh
set -eu

PROGRAM_NAME="seed-proxy-hosts"
SCRIPT_DIR="$(CDPATH='' cd "$(dirname "$0")" && pwd)"
DUGOUT_ROOT="$(CDPATH='' cd "${SCRIPT_DIR}/.." && pwd)"
CONFIG_FILE="${DUGOUT_CONFIG:-${DUGOUT_ROOT}/.env}"

fail() {
  printf '%s: %s\n' "${PROGRAM_NAME}" "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 ||
    fail "$1 is required"
}

set_config_value() {
  config_key="$1"
  config_value="$2"

  case "${config_key}" in
    DUGOUT_NPM_API_URL)
      [ -n "${DUGOUT_NPM_API_URL+x}" ] ||
        DUGOUT_NPM_API_URL="${config_value}"
      ;;
    DUGOUT_NPM_EMAIL)
      [ -n "${DUGOUT_NPM_EMAIL+x}" ] ||
        DUGOUT_NPM_EMAIL="${config_value}"
      ;;
    DUGOUT_NPM_PASSWORD)
      [ -n "${DUGOUT_NPM_PASSWORD+x}" ] ||
        DUGOUT_NPM_PASSWORD="${config_value}"
      ;;
  esac
}

load_config() {
  [ -e "${CONFIG_FILE}" ] || return 0
  [ -r "${CONFIG_FILE}" ] ||
    fail "configuration file is not readable: ${CONFIG_FILE}"

  while IFS= read -r config_line || [ -n "${config_line}" ]; do
    case "${config_line}" in
      "" | \#*) continue ;;
      *=*)
        config_key="${config_line%%=*}"
        config_value="${config_line#*=}"
        ;;
      *) fail "expected KEY=value in ${CONFIG_FILE}: ${config_line}" ;;
    esac

    set_config_value "${config_key}" "${config_value}"
  done < "${CONFIG_FILE}"
}

require_command curl
require_command jq
load_config

DUGOUT_NPM_API_URL="${DUGOUT_NPM_API_URL:-http://localhost:81}"
DUGOUT_NPM_API_URL="${DUGOUT_NPM_API_URL%/}"

[ -n "${DUGOUT_NPM_EMAIL:-}" ] ||
  fail "set DUGOUT_NPM_EMAIL in ${CONFIG_FILE}"
[ -n "${DUGOUT_NPM_PASSWORD:-}" ] ||
  fail "set DUGOUT_NPM_PASSWORD in ${CONFIG_FILE}"

credentials="$(
  jq -cn \
    --arg identity "${DUGOUT_NPM_EMAIL}" \
    --arg secret "${DUGOUT_NPM_PASSWORD}" \
    '{identity: $identity, secret: $secret}'
)"

printf 'Authenticating with Nginx Proxy Manager at %s...\n' \
  "${DUGOUT_NPM_API_URL}"
token_response="$(
  curl -fsS \
    --header 'Content-Type: application/json' \
    --data "${credentials}" \
    "${DUGOUT_NPM_API_URL}/api/tokens"
)" || fail "authentication failed; check the service and NPM credentials"

token="$(printf '%s' "${token_response}" | jq -er '.token')" ||
  fail "Nginx Proxy Manager did not return an access token"

proxy_hosts="$(
  curl -fsS \
    --header "Authorization: Bearer ${token}" \
    --header 'Accept: application/json' \
    "${DUGOUT_NPM_API_URL}/api/nginx/proxy-hosts"
)" || fail "could not list Nginx Proxy Manager proxy hosts"

seed_proxy_host() {
  domain="$1"
  forward_host="$2"
  forward_port="$3"
  websocket="$4"

  if printf '%s' "${proxy_hosts}" |
    jq -e --arg domain "${domain}" \
      'any(.[]; .domain_names | index($domain) != null)' >/dev/null; then
    printf 'Exists:  %-27s\n' "${domain}"
    return
  fi

  payload="$(
    jq -cn \
      --arg domain "${domain}" \
      --arg forward_host "${forward_host}" \
      --argjson forward_port "${forward_port}" \
      --argjson websocket "${websocket}" \
      '{
        domain_names: [$domain],
        forward_scheme: "http",
        forward_host: $forward_host,
        forward_port: $forward_port,
        certificate_id: 0,
        ssl_forced: false,
        hsts_enabled: false,
        hsts_subdomains: false,
        http2_support: false,
        block_exploits: true,
        caching_enabled: false,
        allow_websocket_upgrade: $websocket,
        access_list_id: 0,
        advanced_config: "",
        enabled: true,
        meta: {},
        locations: []
      }'
  )"

  curl -fsS \
    --header "Authorization: Bearer ${token}" \
    --header 'Content-Type: application/json' \
    --data "${payload}" \
    "${DUGOUT_NPM_API_URL}/api/nginx/proxy-hosts" >/dev/null ||
    fail "could not create proxy host ${domain}"

  printf 'Created: %-27s -> %s:%s\n' \
    "${domain}" "${forward_host}" "${forward_port}"
}

seed_proxy_host proxy.localhost do_proxy 81 false
seed_proxy_host portainer.localhost do_portainer 9000 false
seed_proxy_host adminer.localhost do_adminer 8080 false
seed_proxy_host mailpit.localhost do_mailpit 8025 false
seed_proxy_host dozzle.localhost do_dozzle 8080 true
seed_proxy_host minio.localhost do_minio 9001 true
seed_proxy_host s3.localhost do_minio 9000 true

printf '%s\n' 'Nginx Proxy Manager proxy-host seed complete.'
