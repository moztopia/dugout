# ── Service definitions (loaded from YAML) ───────────────────

SERVICES_YAML = "/opt/dugout/docker/services/services.yaml"
_services_cache = None


def load_services():
    """Load service definitions from services.yaml (cached)."""
    global _services_cache
    if _services_cache is not None:
        return _services_cache
    import yaml
    # Try container path first, then workspace path
    for path in [SERVICES_YAML, "/workspace/docker/services/services.yaml"]:
        if os.path.isfile(path):
            with open(path, "r") as f:
                data = yaml.safe_load(f)
            _services_cache = data.get("services", [])
            return _services_cache
    fail("services.yaml not found")
    sys.exit(1)


def get_services():
    """Shorthand for load_services()."""
    return load_services()

USAGE = """
Usage:
  dugout <command>

Commands:
  dugout install [shims|tools|services] [name]     Download and install
  dugout status                                    Show status
  dugout uninstall [shims|tools|services] [name]   Remove installed items

Maintainer:
  dugout admin shims build  [tool]        Build images (all or specific tool)
  dugout admin shims push   [tool]        Push images to GHCR (all or specific tool)
  dugout admin shims deploy [tool]        Build + push (all or specific tool)
  dugout admin shims images               List all defined images and versions
""".strip()


# ── Helpers ──────────────────────────────────────────────────

def usage():
    print(USAGE)


def each_image(action, filter_name=None):
    found = False
    for name, dockerfile, build_arg, versions in IMAGES:
        if filter_name and name != filter_name:
            continue
        found = True
        for ver in versions:
            action(name, dockerfile, build_arg, ver)
    if filter_name and not found:
        fail(f"Unknown tool: {filter_name}")
        sys.exit(1)


# ── Actions ──────────────────────────────────────────────────

def do_build(name, dockerfile, build_arg, ver):
    tag = f"{PREFIX}-{name}:{ver}"
    msg(f"Building {tag}")
    env = {**os.environ, "BUILDX_GIT_INFO": "0"}
    run([
        "docker", "buildx", "build", "--load",
        "--build-arg", f"{build_arg}={ver}",
        "--file", f"/workspace/{dockerfile}",
        "--tag", tag,
        "/workspace",
    ], env=env)


_ghcr_logged_in = False


def ghcr_login():
    """Login to GHCR using GH_DUGOUT_PACKAGES_WRITE if available."""
    global _ghcr_logged_in
    if _ghcr_logged_in:
        return
    token = os.environ.get("GH_DUGOUT_PACKAGES_WRITE", "")
    if token:
        msg("Authenticating with GHCR...")
        result = subprocess.run(
            ["docker", "login", "ghcr.io", "-u", "moztopia", "--password-stdin"],
            input=token, text=True, capture_output=True,
        )
        if result.returncode == 0:
            success("GHCR login")
        else:
            fail("GHCR login failed")
            msg(result.stderr.strip())
            sys.exit(1)
    _ghcr_logged_in = True


def do_push(name, dockerfile, build_arg, ver):
    ghcr_login()
    tag = f"{PREFIX}-{name}:{ver}"
    msg(f"Pushing {tag}")
    run(["docker", "push", tag])


def do_list(name, dockerfile, build_arg, ver):
    tag = f"{PREFIX}-{name}:{ver}"
    print(f"  {name:<12} {tag}")


def install_shims(name=None):
    os.makedirs(INSTALL_DIR, exist_ok=True)
    targets = [name] if name else SHIMS
    for shim in targets:
        if shim not in SHIMS:
            fail(f"Unknown shim: {shim}")
            sys.exit(1)
        download_to(os.path.join(INSTALL_DIR, shim), f"{REPO}/bin/{shim}")
        success(shim)


def install_tools(name=None):
    os.makedirs(INSTALL_DIR, exist_ok=True)
    targets = [name] if name else TOOLS
    for tool in targets:
        if tool not in TOOLS:
            fail(f"Unknown tool: {tool}")
            sys.exit(1)
        download_to(os.path.join(INSTALL_DIR, tool), f"{REPO}/bin/{tool}")
        success(tool)


def uninstall_items(items, label):
    removed = 0
    for item in items:
        path = os.path.join(INSTALL_DIR, item)
        if os.path.isfile(path):
            os.remove(path)
            success(item)
            removed += 1
    if removed == 0:
        msg(f"No {label} installed.")


# ── Services ─────────────────────────────────────────────────

def check_port_available(port):
    """Check if a port is available by trying to find listeners."""
    code, output = run_quiet(["sh", "-c", f"ss -tlnp 2>/dev/null | grep ':{port} ' || true"])
    return output == ""


def check_traefik_running():
    """Check if a Traefik container is already running."""
    code, output = run_quiet([
        "docker", "ps", "--filter", "name=dugout_traefik",
        "--filter", "status=running", "-q",
    ])
    return output != ""


def get_service_config():
    """Load or prompt for service configuration."""
    config = load_config()

    if "network" in config and "domain" in config and "port" in config:
        return config

    header("Service Configuration")
    msg("These settings apply to all dugout services.\n")

    config["network"] = prompt("Docker network name", config.get("network", "dugout-services"))
    config["port"] = prompt("Traefik port (recommended: 80)", config.get("port", "80"))
    config["domain"] = prompt("Domain pattern (e.g. localhost.moztopia.com)", config.get("domain", "localhost"))

    print()
    msg(f"Network:  {config['network']}")
    msg(f"Port:     {config['port']}")
    msg(f"Domain:   {config['domain']}")
    msg(f"Services: traefik.{config['domain']}, portainer.{config['domain']}, ...")
    print()
    confirm("Continue?")

    save_config(config)
    return config


def ensure_network(network):
    """Create the Docker network if it doesn't exist."""
    code, _ = run_quiet(["docker", "network", "inspect", network])
    if code != 0:
        msg(f"Creating network: {network}")
        run_quiet(["docker", "network", "create", network])
        success(f"Network {network}")
    else:
        success(f"Network {network} (exists)")


def ensure_certs(config):
    """Generate self-signed certs and TLS config if they don't exist."""
    from dugout_core import DUGOUT_HOME
    domain = config["domain"]
    cert_dir = os.path.join(DUGOUT_HOME, "certs")
    dynamic_dir = os.path.join(DUGOUT_HOME, "dynamic")
    cert_file = os.path.join(cert_dir, "cert.pem")
    key_file = os.path.join(cert_dir, "key.pem")
    tls_file = os.path.join(dynamic_dir, "tls.yaml")

    os.makedirs(cert_dir, exist_ok=True)
    os.makedirs(dynamic_dir, exist_ok=True)

    # Generate self-signed cert if missing
    if not os.path.isfile(cert_file) or not os.path.isfile(key_file):
        msg(f"Generating TLS certificate for *.{domain}")
        run([
            "openssl", "req", "-x509",
            "-newkey", "rsa:2048",
            "-keyout", key_file,
            "-out", cert_file,
            "-days", "3650",
            "-nodes",
            "-subj", f"/CN=*.{domain}",
            "-addext", f"subjectAltName=DNS:*.{domain},DNS:{domain}",
        ])
        success("TLS certificate")
    else:
        success("TLS certificate (exists)")

    # Write dynamic TLS config
    tls_config = (
        "tls:\n"
        "  stores:\n"
        "    default:\n"
        "      defaultCertificate:\n"
        "        certFile: /certs/cert.pem\n"
        "        keyFile: /certs/key.pem\n"
    )
    with open(tls_file, "w") as f:
        f.write(tls_config)
    success("TLS config")


def start_service(service, config):
    """Start a service container."""
    name = service["name"]
    container_name = f"dugout_{name}"
    network = config["network"]
    domain = config["domain"]
    port = config["port"]

    # Resolve host path for dugout home
    host_home = os.environ.get("DUGOUT_HOST_HOME", "")
    dugout_home = f"{host_home}/.dugout" if host_home else DUGOUT_HOME

    # Check if already running
    code, output = run_quiet([
        "docker", "ps", "--filter", f"name={container_name}",
        "--filter", "status=running", "-q",
    ])
    if output:
        success(f"{name} (already running)")
        return

    # Remove stopped container if exists
    code, output = run_quiet([
        "docker", "ps", "-a", "--filter", f"name={container_name}", "-q",
    ])
    if output:
        run_quiet(["docker", "rm", "-f", container_name])

    # Build docker run command
    cmd = [
        "docker", "run", "-d",
        "--name", container_name,
        "--restart", "unless-stopped",
        "--network", network,
    ]

    # Ports (only traefik)
    for p in service.get("ports", []):
        cmd.extend(["-p", p.format(port=port)])

    # Volumes
    for v in service.get("volumes", []):
        cmd.extend(["-v", v.format(dugout_home=dugout_home)])

    # Labels
    for key, value in service.get("labels", {}).items():
        label_value = value.format(network=network, domain=domain, port=port)
        cmd.extend(["--label", f"{key}={label_value}"])

    # Image
    cmd.append(service["image"])

    # Command args
    for c in service.get("command", []):
        cmd.append(c.format(network=network, domain=domain, port=port))

    result = run(cmd, capture_output=True, text=True)
    if result.returncode == 0:
        success(name)
    else:
        fail(name)
        if result.stderr.strip():
            msg(result.stderr.strip())


def stop_service(name):
    """Stop and remove a service container."""
    container_name = f"dugout_{name}"
    code, output = run_quiet(["docker", "ps", "-a", "--filter", f"name={container_name}", "-q"])
    if output:
        run_quiet(["docker", "stop", container_name])
        run_quiet(["docker", "rm", container_name])
        success(name)
    else:
        msg(f"{name} (not running)")


def install_services(name=None, all_services=False):
    """Install and start services."""
    config = get_service_config()
    network = config["network"]
    port = config["port"]

    # Check port availability (only if traefik not already running)
    if not check_traefik_running():
        if not check_port_available(port):
            fail(f"Port {port} is already in use.")
            msg("Choose a different port or stop the process using it.")
            sys.exit(1)

    # Generate certs and TLS config
    ensure_certs(config)

    # Create network
    ensure_network(network)

    if name:
        # Install specific service by name
        service = next((s for s in get_services() if s["name"] == name), None)
        if not service:
            fail(f"Unknown service: {name}")
            msg("Available: " + ", ".join(s["name"] for s in get_services()))
            sys.exit(1)

        # Traefik must be running for other services
        if name != "traefik" and not check_traefik_running():
            msg("Starting Traefik first (required)...")
            traefik = next(s for s in get_services() if s["name"] == "traefik")
            start_service(traefik, config)

        start_service(service, config)
    elif all_services:
        # Install everything without prompting
        for service in get_services():
            start_service(service, config)
    else:
        # Prompt for each service
        # Traefik is mandatory
        traefik = next(s for s in get_services() if s["name"] == "traefik")
        msg("Traefik (required)")
        start_service(traefik, config)

        print()
        msg("Select additional services:\n")
        for service in get_services():
            if service.get("mandatory"):
                continue
            if prompt_yn(f"Install {service['name']}?", default=True):
                start_service(service, config)

    # Print summary of running services
    print_service_summary(config)


SERVICE_NOTES = {
    "traefik":   "No auth — dashboard is open",
    "portainer": "Set admin password on first visit",
    "dozzle":    "No auth required",
    "adminer":   "Enter your database credentials to connect",
    "mailpit":   "No auth — SMTP on port 1025 inside the Docker network",
}


def print_service_summary(config):
    """Print a summary of running services with URLs."""
    domain = config.get("domain", "localhost")
    port = config.get("port", "80")
    scheme_http = f"http" if port == "80" else f"http"
    port_suffix = "" if port == "80" else f":{port}"

    print()
    print("  ┌─────────────────────────────────────────────────────┐")
    print("  │  Services                                           │")
    print("  ├─────────────────────────────────────────────────────┤")

    for service in get_services():
        container_name = f"dugout_{service['name']}"
        code, output = run_quiet([
            "docker", "ps", "--filter", f"name={container_name}",
            "--filter", "status=running", "-q",
        ])
        if output:
            sname = service["name"]
            url_http = f"http://{sname}.{domain}{port_suffix}"
            url_https = f"https://{sname}.{domain}"
            note = SERVICE_NOTES.get(sname, "")
            print(f"  │  ✓ {sname:<12} {url_http}")
            print(f"  │               {url_https}")
            if note:
                print(f"  │               {note}")
            print("  │")

    print("  └─────────────────────────────────────────────────────┘")
    print()


def uninstall_services(name=None):
    """Stop and remove services."""
    if name:
        if name == "traefik":
            msg("Stopping Traefik will make all services inaccessible.")
            confirm("Continue?")
            # Stop everything
            for service in reversed(get_services()):
                stop_service(service["name"])
        else:
            stop_service(name)
    else:
        header("Stopping all services:")
        for service in reversed(get_services()):
            stop_service(service["name"])
        done()


# ── Commands ─────────────────────────────────────────────────

def cmd_install(args):
    all_services = "--all-services" in args
    args = [a for a in args if a != "--all-services"]

    category = args[0] if args else "shims"
    name = args[1] if len(args) > 1 else None

    if category == "shims":
        header("Installing shims:")
        install_shims(name)
        done()
    elif category == "tools":
        header("Installing tools:")
        install_tools(name)
        done()
    elif category == "services":
        header("Installing services:")
        install_services(name=name, all_services=all_services)
        done()
    else:
        fail(f"Unknown category: {category}")
        msg("Available: shims, tools, services")
        sys.exit(1)


def cmd_status(_args):
    header("Dugout Status")

    # Docker — if we're running, Docker works
    success("Docker: running")

    # PATH check using host PATH passed via env
    host_path = os.environ.get("DUGOUT_HOST_PATH", "")
    host_home = os.environ.get("DUGOUT_HOST_HOME", "")
    install_path = f"{host_home}/.local/bin/dugout" if host_home else ""
    if install_path and f":{install_path}:" in f":{host_path}:":
        success(f"PATH: {install_path}")
    elif install_path:
        fail(f"PATH: {install_path} not in PATH")

    # Installed shims
    print("\n  Installed shims:")
    has_shims = False
    for shim in SHIMS:
        path = os.path.join(INSTALL_DIR, shim)
        if os.path.isfile(path):
            print(f"    ✓ {shim}")
            has_shims = True
    if not has_shims:
        print("    (none)")

    # Installed tools
    print("\n  Installed tools:")
    for tool in TOOLS:
        path = os.path.join(INSTALL_DIR, tool)
        if os.path.isfile(path):
            print(f"    ✓ {tool}")
        else:
            print(f"    ✗ {tool}")

    # Running services
    print("\n  Services:")
    config = load_config()
    domain = config.get("domain", "")
    for service in get_services():
        container_name = f"dugout_{service['name']}"
        code, output = run_quiet([
            "docker", "ps", "--filter", f"name={container_name}",
            "--filter", "status=running", "-q",
        ])
        if output:
            url = f"http://{service['name']}.{domain}" if domain else ""
            print(f"    ✓ {service['name']:<12} {url}")
        else:
            print(f"    ✗ {service['name']}")
    print()


def cmd_uninstall(args):
    category = args[0] if args else None
    name = args[1] if len(args) > 1 else None

    if category is None:
        # Uninstall everything
        print(f"\n  This will remove all dugout shims, tools, and the CLI from:")
        print(f"    {INSTALL_DIR}")
        print(f"\n  And stop all running services.\n")
        confirm("Continue?")

        # Stop services
        for service in reversed(get_services()):
            stop_service(service["name"])

        # Remove files
        if os.path.isdir(INSTALL_DIR):
            for f in os.listdir(INSTALL_DIR):
                path = os.path.join(INSTALL_DIR, f)
                if os.path.isfile(path):
                    os.remove(path)
                    success(f)

        print("\n  Optionally remove cached images:")
        print('    docker images "ghcr.io/moztopia/dugout-*" -q | xargs docker rmi\n')
    elif category == "shims":
        if name:
            path = os.path.join(INSTALL_DIR, name)
            if os.path.isfile(path):
                os.remove(path)
                success(f"Removed {name}")
            else:
                fail(f"{name} is not installed")
                sys.exit(1)
        else:
            header("Removing all shims:")
            uninstall_items(SHIMS, "shims")
            done()
    elif category == "tools":
        if name:
            path = os.path.join(INSTALL_DIR, name)
            if os.path.isfile(path):
                os.remove(path)
                success(f"Removed {name}")
            else:
                fail(f"{name} is not installed")
                sys.exit(1)
        else:
            header("Removing all tools:")
            uninstall_items(TOOLS, "tools")
            done()
    elif category == "services":
        header("Stopping services:")
        uninstall_services(name)
    else:
        fail(f"Unknown category: {category}")
        msg("Available: shims, tools, services")
        sys.exit(1)


def cmd_admin(args):
    if not args:
        usage()
        sys.exit(1)

    admin_cat = args[0]
    sub_args = args[1:]

    if admin_cat == "shims":
        if not sub_args:
            usage()
            sys.exit(1)

        subcommand = sub_args[0]
        tool = sub_args[1] if len(sub_args) > 1 else None

        if subcommand == "build":
            require_maintainer()
            header("Building images:")
            each_image(do_build, tool)
            done()
        elif subcommand == "push":
            require_maintainer()
            header("Pushing images:")
            each_image(do_push, tool)
            done()
        elif subcommand == "deploy":
            require_maintainer()
            header("Building images:")
            each_image(do_build, tool)
            header("Pushing images:")
            each_image(do_push, tool)
            done()
        elif subcommand == "images":
            header("Defined images:")
            each_image(do_list)
            print()
        else:
            usage()
            sys.exit(1)
    else:
        fail(f"Unknown admin category: {admin_cat}")
        msg("Available: shims")
        sys.exit(1)


# ── Main ─────────────────────────────────────────────────────

def main():
    args = sys.argv[1:]

    if check_help(args):
        usage()
        sys.exit(0)

    if not args:
        usage()
        sys.exit(1)

    command = args[0]
    rest = args[1:]

    commands = {
        "install": cmd_install,
        "status": cmd_status,
        "uninstall": cmd_uninstall,
        "admin": cmd_admin,
    }

    handler = commands.get(command)
    if handler:
        handler(rest)
    else:
        usage()
        sys.exit(1)


if __name__ == "__main__":
    main()
